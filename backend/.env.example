# Copy this file to backend/.env and replace every CHANGE_ME value.
# Spring Boot does not load .env automatically; load it into each terminal
# as described in backend/README.md.

JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
GATEWAY_SHARED_SECRET=CHANGE_ME_USE_A_DIFFERENT_32_CHAR_RANDOM_VALUE
PAYMENT_INTERNAL_SECRET=CHANGE_ME_USE_A_THIRD_DIFFERENT_32_CHAR_RANDOM_VALUE

AUTH_DB_USERNAME=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
ROUTE_DB_USERNAME=CHANGE_ME
ROUTE_DB_PASSWORD=CHANGE_ME
TICKET_DB_USERNAME=CHANGE_ME
TICKET_DB_PASSWORD=CHANGE_ME
VEHICLE_DB_USERNAME=CHANGE_ME
VEHICLE_DB_PASSWORD=CHANGE_ME
PAYMENT_DB_USERNAME=CHANGE_ME
PAYMENT_DB_PASSWORD=CHANGE_ME

AUTH_DB_URL=jdbc:mysql://localhost:3306/transport_auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ROUTE_DB_URL=jdbc:mysql://localhost:3306/route_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
TICKET_DB_URL=jdbc:mysql://localhost:3306/ticket_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
VEHICLE_DB_URL=jdbc:mysql://localhost:3306/vehicle_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PAYMENT_DB_URL=jdbc:mysql://localhost:3306/payment_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

EUREKA_URL=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_PREFER_IP_ADDRESS=false
SERVICE_BIND_ADDRESS=127.0.0.1
API_GATEWAY_BIND_ADDRESS=127.0.0.1
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://localhost:3000

# Keep false normally. Set true only for local OTP testing.
EXPOSE_OTP_IN_LOGS=false
